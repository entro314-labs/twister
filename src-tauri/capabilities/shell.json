{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Twister's own webview: the sidebar, tabs, titlebar, status bar, settings and the tools.",
  "webviews": [
    "shell"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:app:allow-version",
    "core:event:default",
    "opener:allow-open-url",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-site-state",
    "allow-navigate-site",
    "allow-site-action",
    "allow-set-site-insets",
    "allow-set-site-visible",
    "allow-sign-out",
    "allow-shell-ready",
    "allow-set-window-material",
    "allow-list-user-assets",
    "allow-open-user-assets-dir",
    "allow-reload-site",
    "allow-show-tooltip",
    "allow-hide-tooltip",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-get-store-counts",
    "allow-list-people",
    "allow-list-posts",
    "allow-export-people",
    "allow-export-posts",
    "allow-clear-captured",
    "allow-start-op",
    "allow-cancel-op",
    "allow-get-ops",
    "allow-prepare-post",
    "allow-post-now",
    "allow-schedule-post",
    "allow-list-scheduled-posts",
    "allow-delete-scheduled-post",
    "allow-open-downloads-dir",
    "allow-update-state",
    "allow-check-for-update",
    "allow-stage-update",
    "allow-restart-and-install"
  ]
}

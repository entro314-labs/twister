{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Explicit because `tooling/` is node code: without `node` here the release
    // scripts' `process` and `node:*` imports resolve to nothing. `vite/client`
    // is what src/vite-env.d.ts references.
    "types": ["node", "vite/client"]
  },
  // `tooling` alongside `src`: the release scripts are run by plain node (Node 26 strips the
  // types), and outside the project they would be neither type-checked nor resolvable by oxlint's
  // type-aware rules, which would see every node global as `any`.
  "include": ["src", "tooling"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

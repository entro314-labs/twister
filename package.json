{
  "name": "twister",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop client for X (Twitter) with niceties injected — Tauri 2, Rust and React 19.",
  "type": "module",
  "license": "MIT",
  "author": "entro314-labs",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt -c .oxfmtrc.jsonc src '!src/routeTree.gen.ts'",
    "fmt:check": "oxfmt -c .oxfmtrc.jsonc --check src '!src/routeTree.gen.ts'",
    "knip": "knip",
    "check:frontend": "pnpm typecheck && pnpm build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm lint && pnpm fmt:check && pnpm check:frontend && pnpm fmt:rust:check && pnpm lint:rust && pnpm test:rust",
    "release": "npx @entro314labs/release-kit@2.9.4",
    "version:current": "node tooling/scripts/version-manager.ts current",
    "version:bump": "node tooling/scripts/version-manager.ts increment",
    "version:set": "node tooling/scripts/version-manager.ts set",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@entro314labs/react-arc-tabs": "^2.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "next",
    "vite": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.7.0"
}
